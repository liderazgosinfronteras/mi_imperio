rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Usuarios — cada quien lee/escribe su propio documento
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Amigas subcollection
      match /amigas/{amigoUid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Códigos de amigas — lectura autenticada para buscar, escritura solo dueño
    match /codigos/{codigo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Salas Imperio Builder
    match /salas/{salaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      // Scores subcollection
      match /scores/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
      // Chat subcollection
      match /chat/{msgId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
      }
    }

    // Salas Cashflow Multijugador
    match /cashflow_rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Salas Monopolio Multijugador
    match /monopolio_rooms/{roomId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // Leaderboard global — lectura pública, escritura autenticada
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
